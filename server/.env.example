# ==========================================================
# PAWS&HEARTS RESCUE PLATFORM ENVIRONMENT CONFIGURATION
# ==========================================================

# Server Port & Mode
PORT=5000
NODE_ENV=development

# 1. NEON POSTGRESQL DATABASE
# Obtain from https://console.neon.tech -> Connection Details -> Connection String (with sslmode=require)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-random-name.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. JWT AUTHENTICATION FOR ADMIN PORTAL
JWT_SECRET=super-secret-jwt-key-change-this-for-production-min-32-chars

# 3. INITIAL ADMIN SEED ACCOUNT
ADMIN_EMAIL=admin@pawsnhearts.org
ADMIN_PASSWORD=PawsRescue2026!
ADMIN_NAME=Rescue Coordinator

# 4. CLOUDFLARE R2 OBJECT STORAGE (Zero Egress Fees)
# (If omitted, local disk storage at /uploads will be used automatically as fallback)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=pawsnhearts-media
R2_PUBLIC_URL=https://pub-yourbucketid.r2.dev

# 5. CLIENT URL (Optional CORS in production)
CLIENT_URL=https://pawsnhearts.onrender.com
