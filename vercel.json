{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite"
    },
    "server": {
      "root": "server",
      "entrypoint": "index.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/pet/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|whatsapp|telegrambot|twitterbot|linkedinbot|discordbot|slackbot|applebot|googlebot|bingbot|pinterest).*"
        }
      ],
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/animals/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|whatsapp|telegrambot|twitterbot|linkedinbot|discordbot|slackbot|applebot|googlebot|bingbot|pinterest).*"
        }
      ],
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/pet/(.*)",
      "destination": {
        "service": "client",
        "path": "/"
      }
    },
    {
      "source": "/animals/(.*)",
      "destination": {
        "service": "client",
        "path": "/"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "client",
        "path": "/"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
