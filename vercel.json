{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "server": {
      "root": "server",
      "entrypoint": "index.js",
      "installCommand": "npm install",
      "buildCommand": "npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/uploads/(.*)",
      "destination": "https://paws.129.225.67.149.sslip.io/uploads/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://paws.129.225.67.149.sslip.io/api/$1"
    },
    {
      "source": "/pet/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|whatsapp|telegrambot|twitterbot|linkedinbot|discordbot|slackbot|applebot|googlebot|bingbot|pinterest).*"
        }
      ],
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/animals/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|whatsapp|telegrambot|twitterbot|linkedinbot|discordbot|slackbot|applebot|googlebot|bingbot|pinterest).*"
        }
      ],
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
