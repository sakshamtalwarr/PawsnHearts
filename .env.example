# ==========================================================
# PAWS&HEARTS RESCUE PLATFORM ENVIRONMENT CONFIGURATION
# ==========================================================

# Server Port & Mode
PORT=5001
NODE_ENV=development

# 1. NEON POSTGRESQL DATABASE
# Obtain from https://console.neon.tech -> Connection Details -> Connection String
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-random-name.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. JWT AUTHENTICATION FOR ADMIN PORTAL
JWT_SECRET=super-secret-jwt-key-change-this-for-production-min-32-chars

# 3. INITIAL ADMIN SEED ACCOUNT
ADMIN_EMAIL=admin@pawsnhearts.org
ADMIN_PASSWORD=PawsRescue2026!
ADMIN_NAME=Rescue Coordinator

# 4. CLOUDINARY (RECOMMENDED: 100% FREE, NO CREDIT CARD OR PAYPAL REQUIRED)
# Sign up in 30 seconds at https://cloudinary.com (with Google or GitHub)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 5. CLOUDFLARE R2 (OPTIONAL - only if you have card/PayPal)
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=pawsnhearts-media
# R2_PUBLIC_URL=https://pub-yourbucketid.r2.dev

# 6. CLIENT URL
CLIENT_URL=https://pawsnhearts.onrender.com
